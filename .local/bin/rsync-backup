#!/bin/sh

if [ "$#" -le 0 ]; then
    echo "usage: $0 <backup dir>" >&2
    exit 1
fi

backup_dir="$1"

rsync \
    --archive \
    --partial \
    --progress \
    --delete \
    -hhh \
    "$HOME/codes" \
    "$HOME/documents" \
    "$HOME/music" \
    "$HOME/pictures" \
    "$HOME/private" \
    "$HOME/world" \
    "$backup_dir"
