#!/bin/sh

###############################################################################
#                        LUKS ENCRYPTED MOUNT & BACKUP                        #
#                     Automated Open, Mount, and Cleanup                      #
###############################################################################

# Set strict shell options: exit on error (-e), treat unset vars as error (-u)
set -eu

# Check for Non-POSIX dependencies
for dep in sudo cryptsetup rsync-backup mount umount mountpoint; do
    if ! command -v "$dep" >/dev/null; then
        echo "Missing dependency: $dep" >&2
        exit 1
    fi
done

#------------------------------------------------------------------------------
# 1. Argument & Device Validation
#------------------------------------------------------------------------------
if [ "$#" -le 0 ]; then
    echo "Error: You need to specify a block device." >&2
    exit 1
fi

DEVICE="$1"

if [ ! -b "$DEVICE" ]; then
    echo "Error: Not a block device: $DEVICE" >&2
    exit 1
fi

#------------------------------------------------------------------------------
# 2. LUKS Device Opening
#------------------------------------------------------------------------------
if test -e /dev/mapper/encrypted; then
    printf "/dev/mapper/encrypted already exists. Continue anyway? [y/N]: "
    read -r answer
    case "$answer" in
        [Yy]*) ;;
        *)
            echo "Aborted." >&2
            exit 1
            ;;
    esac
else
    sudo cryptsetup luksOpen "$DEVICE" encrypted
fi

#------------------------------------------------------------------------------
# 3. Mount Target Setup & Cleanup Trap
#------------------------------------------------------------------------------
MOUNT_POINT="$HOME/external"
BACKUP_DIR="$MOUNT_POINT/backup"

# Ensure cleanup occurs on exit or script failure
CLEANED=0
cleanup() {
    if [ $CLEANED -eq 1 ]; then
        return
    else
        CLEANED=1
    fi

    echo "Cleaning up..." >&2

    if mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
        sudo umount "$MOUNT_POINT"
    fi

    if test -e /dev/mapper/encrypted; then
        sudo cryptsetup luksClose encrypted
    fi
}

trap cleanup EXIT INT TERM

# Mount the decrypted block device
mkdir -p "$MOUNT_POINT"
sudo mount /dev/mapper/encrypted "$MOUNT_POINT"

#------------------------------------------------------------------------------
# 4. Backup Execution
#------------------------------------------------------------------------------
mkdir -p "$BACKUP_DIR"
rsync-backup "$BACKUP_DIR"
