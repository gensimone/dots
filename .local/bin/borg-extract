#!/bin/sh

set -eu

for dep in ssh-keygen ssh-add ssh borg fzf; do
    if ! command -v "$dep" >/dev/null; then
        echo "Missing dependency: $dep" >&2
        exit 1
    fi
done

if [ "$#" -lt 2 ]; then
    echo "Usage: $0 <host> <repository>" >&2
    exit 1
fi

host="$1"

ssh_config="$HOME/.ssh/config"
if ! [ -f "$ssh_config" ]; then
    echo "Missing $ssh_config" >&2
    exit 1
fi
if ! grep "$host" "$ssh_config" >/dev/null; then
    echo "Host '$host' not found" >&2

    echo "Available hosts:"
    grep "Host " "$ssh_config" | sed 's/^/- /'
    exit 1
fi

# TODO: Check for repository
repository="$2"

# Check for ssh key
# NOTE: the ssh key is used to manage the life cycle of the key itself through ssh-agent
ssh_key="$HOME/.ssh/${host}_ed25519"
if ! [ -f "$ssh_key" ]; then
    echo "SSH key '$ssh_key' not found" >&2
    exit 1
fi

# Get key fingerprint to check key presence in ssh-agent
key_fp=$(ssh-keygen -lf "$ssh_key" | awk '{print $2}')
is_key_present() {
    key_fp="$1"

    if ssh-add -l 2>/dev/null | grep -qF "$key_fp"; then
        return 0
    else
        return 1
    fi
}

# We want to remove the key only if `ssh-add <key>`has been excecuted
ssh_added=0
if ! is_key_present "$key_fp"; then
    ssh-add "$ssh_key"
    ssh_added=1
fi

stty_orig=""
cleanup() {
    if [ -n "$stty_orig" ]; then
        stty "$stty_orig" || true
    fi

    if [ $ssh_added -eq 1 ] && is_key_present "$key_fp"; then
        ssh-add -d "$ssh_key"
    fi
}

abort() {
    cleanup
    echo "Aborted" >&2
    exit 1
}

trap abort INT TERM
trap cleanup EXIT

# Get the Borg repository passphrase
stty_orig=$(stty -g) # Save current terminal settings before modifying
stty -echo           # Disable terminal echoing so passwords are not shown on screen

printf "Enter passphrase for key ssh://$host/./$repository: "
read -r BORG_PASSPHRASE
printf '\n'

stty "$stty_orig"
stty_orig=""

if [ -z "$BORG_PASSPHRASE" ]; then
    echo "Error: Borg passphrase cannot be empty." >&2
    abort
fi
export BORG_PASSPHRASE

echo "Fetching archive list..."
borg_list=$(borg list ssh://"$host"/./"$repository") || abort

archive=$(printf '%s\n' "$borg_list" | fzf | awk '{print $1}') || abort

if [ -z "$archive" ]; then
    echo "No archive selected."
    abort
fi

echo "Extracting archive: $archive..."
borg extract --progress --list ssh://"$host"/./"$repository"::"$archive"
