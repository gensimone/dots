#!/bin/sh

if [ "$#" -lt 2 ]; then
    echo "Usage: $0 <host> <repository>" >&2
    exit 1
fi

HOST="$1"
REPOSITORY="$2"

borg create \
    --progress \
    --stats \
    --compression zstd \
    --exclude '*/.cache' \
    --exclude '*/node_modules' \
    ssh://"$HOST"/./"$REPOSITORY"::{hostname}-{now} \
    "$HOME/codes" \
    "$HOME/documents" \
    "$HOME/music" \
    "$HOME/pictures" \
    "$HOME/private" \
    "$HOME/world"
