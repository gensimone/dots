[user]
    name = Simone Gentili
    email = gensimone.git@gmail.com

[alias]
    a = add
    b = branch
    c = commit
    count = rev-list --all --count
    d = diff
    l = log
    lg = log
    r = restore
    s = status
    undo = reset HEAD~
    unstage = reset HEAD --

[init]
    defaultBranch = main

[core]
    editor = nvim
