# ==============================================================================
# OUTPUT & PATH FORMATTING
# ==============================================================================

# Save files under ~/music structured by Uploader / Playlist / Index - Title
-o "~/music/%(uploader)s/%(playlist)s/%(playlist_index)s - %(title)s.%(ext)s"


# ==============================================================================
# AUDIO EXTRACTION & CONVERSION
# ==============================================================================

# Extract audio track from video
-x

# Convert extracted audio to MP3 format (replacing invalid -t flag)
--audio-format mp3


# ==============================================================================
# METADATA & THUMBNAIL EMBEDDING
# ==============================================================================

# Embed metadata (artist, title, album, track number) into the output file
--embed-metadata

# Embed album art / thumbnail into the audio file
--embed-thumbnail

# Convert thumbnail to JPEG format before embedding for maximum compatibility
--convert-thumbnail jpg

# Post-processor argument: Crop image to a square aspect ratio using FFmpeg before embedding
--ppa "EmbedThumbnail+ffmpeg_o:-c:v mjpeg -vf crop=\"'if(gt(ih,iw),iw,ih)':'if(gt(iw,ih),ih,iw)'\""
